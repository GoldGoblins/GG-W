  "local_models": {
    "delivery": "user-installed weights outside source",
    "configuration": "model paths and container checks remain local; the desktop can start with a cloud TUI without weights"
  },
  "provider_authentication": "Each user signs in through the provider client; authentication files and tokens are never distributed.",
  "windows": {
    "python_environment": ".venv-windows",
    "qt_version": "6.11.2",
    "launcher": "run-gg-ai-desktop.cmd",
    "setup": "setup-windows.cmd",
    "cli_wrappers": "gg-*.cmd",
    "terminal": "ConPTY via pywinpty",
    "worker_limits": "Windows Job Objects",
    "web_browser": {
      "engine": "Microsoft Edge WebView2 through Qt WebView or the optional GG extension host",
      "scope": "All WEB tabs, all HTTP/HTTPS sites",
      "profile": "Per-user application state / webview2-profile",
      "delivery": "Microsoft Evergreen Runtime, supplied and updated by Microsoft",
      "installation": "https://developer.microsoft.com/microsoft-edge/webview2/",
      "content_blocking": {
        "provider": "uBlock Origin",
        "version": "1.75.0",
        "manifest_version": 2,
        "package": "https://github.com/gorhill/uBlock/releases/download/1.75.0/uBlock0_1.75.0.chromium.zip",
        "source": "https://github.com/gorhill/uBlock",
        "license": "GPL-3.0-or-later",
        "modified": false,
        "bundled": false,
        "delivery": "Original publisher archive installed per user outside source",
        "installation": "tools/install_web_filter.py",
        "controls": "Per-site on/off and the original uBO dashboard",
        "compatibility": "Verified on WebView2 155.0.4283.62; future Manifest V2 support depends on Microsoft"
      },
      "extension_host": {
        "source": "native/webview/gg_webview.cpp",
        "binary": "backend/native/windows-x86_64/gg_webview.dll",
        "sdk": "Microsoft.Web.WebView2",
        "sdk_version": "1.0.4258.31",
        "sdk_package": "https://api.nuget.org/v3-flatcontainer/microsoft.web.webview2/1.0.4258.31/microsoft.web.webview2.1.0.4258.31.nupkg",
        "sdk_delivery": "Original Microsoft NuGet package during explicit build/install",
        "sdk_license": "native/webview/MICROSOFT-LICENSE.txt",
        "sdk_notice": "native/webview/MICROSOFT-NOTICE.txt",
        "startup_download": false,
        "debug_port": false
      }
    },
    "native_libraries": "backend/native/windows-x86_64 or windows-arm64",
    "linux_workers": "Configured Podman Linux VM; no host fallback without isolation"
  },
