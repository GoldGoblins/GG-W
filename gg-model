#!/usr/bin/python3
"""Shared reference-driven Blender workflow. One bounded operation per call."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
from backend.blender_reference_workflow import OPERATIONS, execute


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=OPERATIONS)
    parser.add_argument("--input", default="-", help="JSON file; default reads JSON from stdin")
    args = parser.parse_args()
    try:
        body = sys.stdin.read(65537) if args.input == "-" else Path(args.input).read_text(encoding="utf-8")
        if len(body) > 65536:
            raise ValueError("Workflow input exceeds 64 KiB")
        result = execute(args.operation, json.loads(body or "{}"))
        print(json.dumps({"ok": True, **result}, ensure_ascii=False, indent=2))
        return 0
    except (ValueError, KeyError, OSError, RuntimeError, TypeError) as exc:
        print(json.dumps({"ok": False, "error": str(exc)[:500]}, ensure_ascii=False))
        return 1


from backend.platform_support import configure_stdio
configure_stdio()

if __name__ == "__main__":
    raise SystemExit(main())
